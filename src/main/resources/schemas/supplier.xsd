<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.greyshield.com/schema/supplier"
           xmlns:sup="http://www.greyshield.com/schema/supplier"
           elementFormDefault="qualified">

    <xs:element name="suppliers" type="sup:SuppliersType"/>

    <xs:complexType name="SuppliersType">
        <xs:sequence>
            <xs:element name="supplier" type="sup:SupplierType" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SupplierType">
        <xs:sequence>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="rating" type="xs:string"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>

</xs:schema>
